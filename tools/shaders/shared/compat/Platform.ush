// Platform.ush: indirect dispatch parameter layout.
#define DISPATCH_INDIRECT_NO_PADDING_UINT_COUNT 3

#ifndef DISPATCH_INDIRECT_UINT_COUNT
#define DISPATCH_INDIRECT_UINT_COUNT DISPATCH_INDIRECT_NO_PADDING_UINT_COUNT
#endif

void WriteDispatchIndirectArgs(RWBuffer<uint> RWIndirectDispatchArgsBuffer, in uint InIndex, in uint InIndirectArgX, in uint InIndirectArgY, in uint InIndirectArgZ)
{
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 0] = InIndirectArgX;
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 1] = InIndirectArgY;
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 2] = InIndirectArgZ;
}
void WriteDispatchIndirectArgs(RWBuffer<uint> RWIndirectDispatchArgsBuffer, in uint InIndex, in uint3 InIndirectArg)
{
	WriteDispatchIndirectArgs(RWIndirectDispatchArgsBuffer, InIndex, InIndirectArg.x, InIndirectArg.y, InIndirectArg.z);
}

// Structured-buffer variant for host indirect arguments stored as uint words.
void WriteDispatchIndirectArgs(RWStructuredBuffer<uint> RWIndirectDispatchArgsBuffer, in uint InIndex, in uint InIndirectArgX, in uint InIndirectArgY, in uint InIndirectArgZ)
{
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 0] = InIndirectArgX;
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 1] = InIndirectArgY;
	RWIndirectDispatchArgsBuffer[DISPATCH_INDIRECT_UINT_COUNT * InIndex + 2] = InIndirectArgZ;
}

void WriteDispatchIndirectArgs(RWStructuredBuffer<uint> RWIndirectDispatchArgsBuffer, in uint InIndex, in uint3 InIndirectArg)
{
	WriteDispatchIndirectArgs(RWIndirectDispatchArgsBuffer, InIndex, InIndirectArg.x, InIndirectArg.y, InIndirectArg.z);
}

#ifndef DRAW_INDIRECT_UINT_COUNT
#define DRAW_INDIRECT_UINT_COUNT 4
void WriteIndirectDrawArgs(RWBuffer<uint> OutIndirectArgsBuffer, in uint InIndex, in uint InVertexCount, in uint InInstanceCount, in uint StartVertexLocation = 0, in uint StartInstanceLocation = 0)
{
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 0] = InVertexCount;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 1] = InInstanceCount;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 2] = StartVertexLocation;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 3] = StartInstanceLocation;
}
void WriteIndirectDrawArgs(RWStructuredBuffer<uint> OutIndirectArgsBuffer, in uint InIndex, in uint InVertexCount, in uint InInstanceCount, in uint StartVertexLocation = 0, in uint StartInstanceLocation = 0)
{
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 0] = InVertexCount;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 1] = InInstanceCount;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 2] = StartVertexLocation;
	OutIndirectArgsBuffer[DRAW_INDIRECT_UINT_COUNT * InIndex + 3] = StartInstanceLocation;
}
#endif

#ifndef BitFieldInsertU32
uint BitFieldInsertU32(uint Mask, uint Preserve, uint Enable)
{
	return (Preserve & Mask) | (Enable & ~Mask);
}
#endif

#ifndef BitFieldExtractU32
uint BitFieldExtractU32(uint Data, uint Size, uint Offset)
{
	Size &= 31;
	Offset &= 31;
	return (Data >> Offset) & ((1u << Size) - 1u);
}
#endif

#ifndef BitFieldExtractI32
int BitFieldExtractI32(int Data, uint Size, uint Offset)
{
	Size &= 31u;
	Offset &= 31u;
	const uint Shift = (32u - Size) & 31u;
	const int Value = (Data >> Offset) & int((1u << Size) - 1u);
	return (Value << Shift) >> Shift;
}
#endif

#ifndef BitFieldMaskU32
uint BitFieldMaskU32(uint MaskWidth, uint MaskLocation)
{
	MaskWidth &= 31u;
	MaskLocation &= 31u;
	return ((1u << MaskWidth) - 1u) << MaskLocation;
}
#endif

#ifndef BitFieldSetU32
void BitFieldSetU32(inout uint Packed, uint V, uint Size, uint Offset)
{
	Packed |= (V & BitFieldMaskU32(Size, 0)) << Offset;
}
#endif

#ifndef BitFieldExtractFloat
float BitFieldExtractFloat(uint Bits, uint Count, uint Offset)
{
	return BitFieldExtractU32(Bits, Count, Offset) / (float)BitFieldMaskU32(Count, 0u);
}
#endif

#endif // LUMENFX_SHADER_PLATFORM_COMPAT
