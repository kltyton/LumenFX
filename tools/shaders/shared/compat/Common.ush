// ---------------------------------------------------------------------------
// Large world coordinates / double-float.  Source:
// Engine/Shaders/Private/LargeWorldCoordinates.ush,
// Engine/Shaders/Private/DoubleFloat.ush,
// Engine/Shaders/Private/DoubleFloatOperations.ush.
//
// The engine defines these from ShaderCompiler.cpp using
// FLargeWorldRenderScalar::GetTileSize():
//   UE_LWC_RENDER_TILE_SIZE       = 2097152.0f (2^21)
//   UE_LWC_RENDER_TILE_SIZE_SQRT  = sqrt(TileSize)
//   UE_LWC_RENDER_TILE_SIZE_RSQRT = rsqrt(TileSize)
//   UE_LWC_RENDER_TILE_SIZE_RCP   = 1.0f / TileSize
//   UE_LWC_RENDER_TILE_SIZE_FMOD_PI  = fmod(TileSize, PI)
//   UE_LWC_RENDER_TILE_SIZE_FMOD_2PI = fmod(TileSize, 2.0 * PI)
// (Engine/Source/Runtime/Core/Public/Misc/LargeWorldRenderPosition.h:14)
// ---------------------------------------------------------------------------
#ifndef UE_LWC_RENDER_TILE_SIZE
#define UE_LWC_RENDER_TILE_SIZE 2097152.0f
#endif
#ifndef UE_LWC_RENDER_TILE_SIZE_SQRT
#define UE_LWC_RENDER_TILE_SIZE_SQRT sqrt(UE_LWC_RENDER_TILE_SIZE)
#endif
#ifndef UE_LWC_RENDER_TILE_SIZE_RSQRT
#define UE_LWC_RENDER_TILE_SIZE_RSQRT rsqrt(UE_LWC_RENDER_TILE_SIZE)
#endif
#ifndef UE_LWC_RENDER_TILE_SIZE_RCP
#define UE_LWC_RENDER_TILE_SIZE_RCP (1.0f / UE_LWC_RENDER_TILE_SIZE)
#endif
#ifndef UE_LWC_RENDER_TILE_SIZE_FMOD_PI
#define UE_LWC_RENDER_TILE_SIZE_FMOD_PI fmod(UE_LWC_RENDER_TILE_SIZE, 3.14159265358979323846f)
#endif
#ifndef UE_LWC_RENDER_TILE_SIZE_FMOD_2PI
#define UE_LWC_RENDER_TILE_SIZE_FMOD_2PI fmod(UE_LWC_RENDER_TILE_SIZE, 6.28318530717958647692f)
#endif

