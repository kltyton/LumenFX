// ---------------------------------------------------------------------------
// Global sampler.  The engine exposes the bilinear clamped static sampler
// through GetGlobalSampler(Bilinear, Clamped) at s3/space1000.  This adapter
// therefore declares the same slot directly, or uses GetGlobalSampler when the
// platform layer provides it.
// ---------------------------------------------------------------------------
#ifndef GlobalBilinearClampedSampler
	#if defined(GetGlobalSampler)
		#define GlobalBilinearClampedSampler GetGlobalSampler(Bilinear, Clamped)
	#else
		[[vk::binding(64, 0)]] SamplerState GlobalBilinearClampedSampler : register(s3, space1000);
	#endif
#endif

#ifndef GlobalPointClampedSampler
	#if defined(GetGlobalSampler)
		#define GlobalPointClampedSampler GetGlobalSampler(Point, Clamped)
	#else
		[[vk::binding(65, 0)]] SamplerState GlobalPointClampedSampler : register(s1, space1000);
	#endif
#endif

#ifndef GlobalPointWrappedSampler
	#if defined(GetGlobalSampler)
		#define GlobalPointWrappedSampler GetGlobalSampler(Point, Wrapped)
	#else
		[[vk::binding(66, 0)]] SamplerState GlobalPointWrappedSampler : register(s0, space1000);
	#endif
#endif

#ifndef GlobalBilinearWrappedSampler
	#if defined(GetGlobalSampler)
		#define GlobalBilinearWrappedSampler GetGlobalSampler(Bilinear, Wrapped)
	#else
		[[vk::binding(67, 0)]] SamplerState GlobalBilinearWrappedSampler : register(s2, space1000);
	#endif
#endif

#ifndef GlobalTrilinearClampedSampler
	#if defined(GetGlobalSampler)
		#define GlobalTrilinearClampedSampler GetGlobalSampler(Trilinear, Clamped)
	#else
		[[vk::binding(68, 0)]] SamplerState GlobalTrilinearClampedSampler : register(s4, space1000);
	#endif
#endif

#ifndef GlobalTrilinearWrappedSampler
	#if defined(GetGlobalSampler)
		#define GlobalTrilinearWrappedSampler GetGlobalSampler(Trilinear, Wrapped)
	#else
		[[vk::binding(69, 0)]] SamplerState GlobalTrilinearWrappedSampler : register(s5, space1000);
	#endif
#endif
