#pragma once

#ifndef HLSL_STATIC_ASSERT
#define LFX_JOIN_ASSERT_NAME_IMPL(Left, Right) Left##Right
#define LFX_JOIN_ASSERT_NAME(Left, Right) LFX_JOIN_ASSERT_NAME_IMPL(Left, Right)
// DXC's SPIR-V backend rejects _Static_assert. A failed condition still fails compilation.
#define HLSL_STATIC_ASSERT(Expr, Msg) static const uint LFX_JOIN_ASSERT_NAME(LfxShaderAssertion_, __LINE__)[(Expr) ? 1 : -1] = {0u}
#endif
