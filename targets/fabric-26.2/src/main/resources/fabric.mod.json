{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.kltyton.lumenfx.loader.fabric.LumenFxFabricMod"],
    "client": ["com.kltyton.lumenfx.loader.fabric.LumenFxFabricClientMod"]
  },
  "accessWidener": "lumenfx.accesswidener",
  "mixins": [
    "lumenfx.mixins.json",
    "lumenfx.simulation.mixins.json",
    "lumenfx.audio.mixins.json",
    "lumenfx.motion.mixins.json",
    "lumenfx.scene.mixins.json",
    "lumenfx.compute.mixins.json",
    "lumenfx.graphics.mixins.json",
    "lumenfx.material_blend.mixins.json",
    "lumenfx.texture.mixins.json",
    "lumenfx.virtual_texture.mixins.json",
    "lumenfx.iris.mixins.json",
    "lumenfx.sodium.mixins.json",
    "lumenfx.photon.mixins.json",
    "lumenfx.collision.mixins.json",
    "lumenfx.keyframe.mixins.json",
    "lumenfx.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "fabric-api": ">=0.161.0",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "iris": ">=1.11.4",
    "sodium": ">=0.9.2"
  }
}
