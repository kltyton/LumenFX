{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.kltyton.lumenfx.loader.fabric.LumenFxFabric1211Mod"],
    "client": ["com.kltyton.lumenfx.loader.fabric.LumenFxFabric1211ClientMod"]
  },
  "mixins": [
    "lumenfx.keyframe.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": ">=0.116.15"
  },
  "suggests": {
    "iris": ">=1.8.0",
    "sodium": ">=0.6.0"
  }
}
